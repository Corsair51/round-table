@page "/"

<PageTitle>Round Table</PageTitle>

<div class="container-fluid py-3">
    <div class="mb-4">
        <h1 class="h3 mb-1">Round Table</h1>
        <p class="text-muted mb-3">Equal AI peers advising a human decision-maker.</p>

        <div class="mb-2">
            <label for="promptInput" class="form-label fw-semibold">Prompt</label>
            <textarea id="promptInput"
                      class="form-control"
                      rows="4"
                      placeholder="Enter your architectural question or problem statement..."
                      disabled="@IsRunning"
                      @bind="PromptText"
                      @bind:event="oninput"></textarea>
        </div>

        <div class="d-flex align-items-center gap-3">
            <button type="button"
                    class="btn btn-primary"
                    disabled="@IsRunning"
                    @onclick="StartSessionAsync">
                @(IsRunning ? "Convening..." : "Convene Council")
            </button>

            <span class="text-muted small">@StatusMessage</span>
    </div>

        <details class="mb-4 border rounded p-3">
            <summary class="fw-semibold">Stage 1 &amp; 2: Initial Drafts &amp; Cross-Critiques</summary>
            <div class="row g-3 mt-2">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header fw-semibold">Gemini — Draft &amp; Critique</div>
                        <div class="card-body text-muted small">
                            Awaiting session...
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header fw-semibold">Copilot — Draft &amp; Critique</div>
                        <div class="card-body text-muted small">
                            Awaiting session...
                        </div>
                    </div>
                </div>
            </div>
        </details>

        <div>
            <h2 class="h5 mb-3">Stage 3: Final Revisions</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header fw-semibold">Gemini — Final Response</div>
                        <div class="card-body text-muted small">
                            No output yet.
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card h-100">
                        <div class="card-header fw-semibold">Copilot — Final Response</div>
                        <div class="card-body text-muted small">
                            No output yet.
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>